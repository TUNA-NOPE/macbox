+    /// answers as: what [`Device::pixel_format_info`] answers on every device, for a caller
+    /// that holds none (a descriptor's setter). No Metal counterpart: Metal's takes a device.
+    pub fn of(raw: u64) -> PixelFormatInfo {
+        pixel_format_info(raw)
+    }
+
     /// Whether Metal describes a format here (any answer but [`INVALID`](Self::INVALID)).
     pub fn describes_a_format(&self) -> bool {
         *self != PixelFormatInfo::INVALID
@@ -208,6 +215,13 @@ pub struct TextureLevelInfo {
 }
 

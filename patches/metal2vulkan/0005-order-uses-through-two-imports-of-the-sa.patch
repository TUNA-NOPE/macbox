+/// macbox: `used`, a use added for a key of another import of the same pages where
+/// `other` (the module docs), with `MEMORY_WRITE` among the access types of its reads and of its
+/// writes: a barrier between it and any use of the key it is added for then carries
+/// `MEMORY_WRITE` on its side, which ANV takes as its full flush, so a write through one import
+/// is in the pages before a read through the other. Its stages stay its own (`MEMORY_WRITE` is
+/// valid in every stage), and a barrier inside a render pass keeps to its subpass's dependency,
+/// which masks the access types (`render_target.rs`).
+fn apart(mut used: Use<ResourceKey>, other: bool) -> Use<ResourceKey> {
+    if !other {
+        return used;
+    }
+    let strong = |side: Access| match side.is_empty() {
+        true => side,
+        false => Access::new(side.stages, side.access | vk::AccessFlags2::MEMORY_WRITE),
+    };
+    used.read = strong(used.read);
+    used.write = strong(used.write);
+    used
+}

diff --git a/crates/metal2vulkan-runtime/src/live.rs b/crates/metal2vulkan-runtime/src/live.rs
new file mode 100644
index 00000000..cc6e810b
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/live.rs
@@ -0,0 +1,129 @@
+//! macbox experiment switches that change while the process runs. `M2V_LIVE=<path>`
+//! names a file of `name=value` lines (`#` starts a comment); a switch asked re-reads the file
+//! at most once a second, when its modification time changed, so an A/B pair shares one boot.
+//! Unset, every switch answers its default and no file is read. A changed file is logged once
+//! on stderr with the values taken. A switch decides only the work recorded or the objects made
+//! after the change: images, pipelines and passes made before keep the form they took.
+//!
+//! - [`on`]: a boolean switch (`1`/`true`/`on`/`yes`, `0`/`false`/`off`/`no`).
+//! - [`get`]: a switch's raw value.
+//! - [`fact`]: a driver fact as the device has it, unless `facts_off` or `facts_on` (comma lists
+//!   of `DriverFact` names) name it.
+
+use metal2vulkan::device::DriverFact;
+use std::collections::BTreeMap;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, OnceLock, RwLock};
+use std::time::{Instant, SystemTime};
+
+struct Live {
+    path: PathBuf,
+    /// Milliseconds since `START` at the last look at the file.
+    looked: AtomicU64,
+    mtime: RwLock<Option<SystemTime>>,
+    values: RwLock<Arc<BTreeMap<String, String>>>,
+}
+
+static START: OnceLock<Instant> = OnceLock::new();
+static LIVE: OnceLock<Option<Live>> = OnceLock::new();
+
+fn live() -> Option<&'static Live> {
+    LIVE.get_or_init(|| {
+        let path = PathBuf::from(std::env::var_os("M2V_LIVE")?);
+        START.get_or_init(Instant::now);
+        let live = Live {
+            path,
+            looked: AtomicU64::new(0),
+            mtime: RwLock::new(None),
+            values: RwLock::new(Arc::new(BTreeMap::new())),
+        };
+        live.refresh();
+        Some(live)
+    })
+    .as_ref()
+}
+
+impl Live {
+    fn refresh(&self) {
+        let mtime = std::fs::metadata(&self.path).and_then(|m| m.modified()).ok();
+        if *self.mtime.read().unwrap() == mtime && mtime.is_some() {
+            return;
+        }
+        *self.mtime.write().unwrap() = mtime;
+        let text = std::fs::read_to_string(&self.path).unwrap_or_default();
+        let values: BTreeMap<String, String> = text
+            .lines()
+            .map(|l| l.split('#').next().unwrap_or("").trim())
+            .filter_map(|l| l.split_once('='))
+            .map(|(k, v)| (k.trim().to_owned(), v.trim().to_owned()))
+            .filter(|(k, _)| !k.is_empty())
+            .collect();
+        let line = format!("metal2vulkan live: {}: {values:?}\n", self.path.display());
+        let _ = std::io::Write::write_all(&mut std::io::stderr(), line.as_bytes());
+        *self.values.write().unwrap() = Arc::new(values);
+    }
+
+    fn values(&self) -> Arc<BTreeMap<String, String>> {
+        let now = START.get().map_or(0, |s| s.elapsed().as_millis() as u64);
+        let looked = self.looked.load(Ordering::Relaxed);
+        if now.saturating_sub(looked) >= 1000
+            && self
+                .looked
+                .compare_exchange(looked, now, Ordering::Relaxed, Ordering::Relaxed)
+                .is_ok()
+        {
+            self.refresh();
+        }
+        self.values.read().unwrap().clone()
+    }
+}
+
+/// The switch `name`'s value, where the file sets it.
+pub fn get(name: &str) -> Option<String> {
+    live()?.values().get(name).cloned()
+}
+
+/// The boolean switch `name`, `default` where the file does not set it (or sets it to neither).
+pub fn on(name: &str, default: bool) -> bool {
+    match get(name).as_deref() {
+        Some("1" | "true" | "on" | "yes") => true,
+        Some("0" | "false" | "off" | "no") => false,
+        _ => default,
+    }
+}
+
+/// Whether the comma list `list` names `item`.
+fn names(list: &str, item: &str) -> bool {
+    list.split(',').map(str::trim).any(|n| n == item)
+}
+
+/// The driver fact `fact` as `facts` (the device's) has it, unless the switch `facts_off` names
+/// it (off) or `facts_on` does (on).
+pub fn fact(facts: &std::collections::BTreeSet<DriverFact>, fact: DriverFact) -> bool {
+    let has = facts.contains(&fact);
+    let Some(live) = live() else { return has };
+    let values = live.values();
+    if !values.contains_key("facts_off") && !values.contains_key("facts_on") {
+        return has;
+    }
+    let name = format!("{fact:?}");
+    if values.get("facts_off").is_some_and(|l| names(l, &name)) {
+        return false;
+    }
+    if values.get("facts_on").is_some_and(|l| names(l, &name)) {
+        return true;
+    }
+    has
+}
+
+/// [`fact`] as a method of the device's fact set, for the runtime's read sites.
+pub(crate) trait LiveFacts {
+    fn live_has(&self, fact: DriverFact) -> bool;
+}
+
+impl LiveFacts for std::collections::BTreeSet<DriverFact> {
+    fn live_has(&self, f: DriverFact) -> bool {
+        fact(self, f)
+    }
+}

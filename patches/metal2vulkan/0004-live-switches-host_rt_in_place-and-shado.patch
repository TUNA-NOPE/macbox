diff --git a/crates/metal2vulkan-runtime/src/host_rt.rs b/crates/metal2vulkan-runtime/src/host_rt.rs
new file mode 100644
index 00000000..f56f6938
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/host_rt.rs
@@ -0,0 +1,806 @@
+//! macbox: textures over host pages that render or write, in place.
+//!
+//! Upstream takes a texture over host pages in place only where its declared usage samples or
+//! reads it (`in_place.rs`): one that renders into it or writes it through a shader is a shadow
+//! (`ShadowCause::RenderTarget`, `ShadowCause::ShaderWrite`), copied in before each use and merged
+//! back after each write, because an image bound to host pages starts `UNDEFINED`
+//! (`VUID-VkImageCreateInfo-pNext-01443`) and Vulkan lets its layout transitions and a render
+//! pass's load and store operations read and write every byte bound to it: the bytes between its
+//! rows and around its render area among them, which the CPU (the guest) may write meanwhile.
+//!
+//! - **The switch.** `host_rt_in_place` (`live.rs`, default off) takes such a texture in place,
+//!   under `HostPageTexturePolicy::InPlace`, where the device's check of the first move passed for
+//!   the pages' class (`in_place_check.rs`) and so did the check below. Decided as the texture is
+//!   made: a texture made before the switch changed keeps its form.
+//! - **Its image** is the image in place `texture/in_place_image.rs` makes (a linear image made for
+//!   host allocations, or a `DRM_FORMAT_MOD_LINEAR` one at Metal's pitch, or a dma-buf's), tried as
+//!   a linear image aliasing a buffer of the runtime's own is (`Device::storage_over_buffer`'s
+//!   `None` branch): with the feedback loop usage, then with the usage the texture lacks, then
+//!   with its own plan, the first the device makes. From there it is an aliasing image like any
+//!   other: render passes, tile dispatches, the interlock and compute writes take it as they take a
+//!   linear image over a buffer of the runtime's own, and the tracker orders it as the buffer's
+//!   bytes (its identity is theirs).
+//! - **Relying on the driver, checked** ([`check_class`]), as upstream's sampled case does: per
+//!   class of pages, on a thread of its own, for each of [`SHAPES`] (1, 4, 8 and 16-byte texels,
+//!   rows apart and one after another, and the 3440x1440 desktop at a 13824-byte pitch) twice: the
+//!   pattern written, a texture of `RenderTarget | ShaderRead` usage made over the pages (the
+//!   product's path), then one internal submission that makes the image's first move from
+//!   `UNDEFINED`, a render pass that loads and stores it over its whole area and clears a
+//!   rectangle inside through `vkCmdClearAttachments`, one whose render area is a second rectangle
+//!   that it clears through its load, and one whose render area is a third that it loads
+//!   `DONT_CARE`, each in `GENERAL` as the runtime renders. A thread of its own writes the
+//!   pattern's complement into every byte that is not a texel (between the rows, after the image),
+//!   paced so its writes run while the device works. Then each such byte must read the CPU's
+//!   write where the CPU wrote it and the pattern elsewhere, the first two rectangles their clear
+//!   values, and every texel outside the three rectangles the pattern. The third rectangle's
+//!   texels are left unchecked (`DONT_CARE`). The verdict is kept for the device's life (no
+//!   record), noted on stderr once.
+//! - **When.** Where the switch is on as the device is made, the check starts then; else at the
+//!   first texture that asks, which waits for it ([`WAIT`] at most; a pending verdict leaves the
+//!   texture a shadow). A device made to fail its in-place check fails this one too.
+//! - **Why it is sound on ANV** (Mesa 26.2.4, the Arrow Lake iGPU it was written for): a linear
+//!   image and an external one get no aux surface (`anv_image.c`: "Disabling aux: external image
+//!   without DRM modifier", and no CCS for linear tiling), so a layout transition, from
+//!   `UNDEFINED` too, touches no memory, and the load and store operations of a pass touch only
+//!   the texels of its render area. The check holds the driver to that (it passed for pages
+//!   imported by their pointer and fresh pages, in 0.25 s; dma-bufs unchecked there).
+//! - **Ordering.** An image in place is keyed as its buffer, and the tracker orders two buffers
+//!   over the same host bytes by their placements (`host_aliases.rs`); under the switch an
+//!   image's use of such a key takes the uses of every byte the key lies over, as a byte use
+//!   does (`host_aliases::augmented`).
+//! - **What differs from the shadow** (the GPU lanes over host pages, `M2V_LANE_IN_PLACE=1`): a
+//!   pass's `Clear` load of the linear image rounds as ANV's linear clears do, one code from the
+//!   optimal image's in places (0.1 into `BGRA8Unorm`: 0x19, where the optimal image and Metal
+//!   write 0x1a; the draws after it blend exactly alike), as upstream's linear images over the
+//!   runtime's own buffers already do; and a read through a second, separate import of the same
+//!   pages (a buffer made after `host_range_remapped`) in the same command buffer as the pass's
+//!   write read about 2% of its texels stale (`surface_aliases`), where the shadow's merge read
+//!   none; in another command buffer or on another queue, fresh. Imports of one surface's pages
+//!   that join (the usual case) read fresh.
+//! - **Cost** (`host_rt_frames.rs`, the Arrow Lake iGPU): a pass into a linear image costs far
+//!   more than into an optimal one (blending 1.5 screens of 3440x1440: 0.66 ms into a `Private`
+//!   texture, 4.9 ms into a linear image in the device's own memory, 5.4 ms in place over host
+//!   pages), where the shadow's copies cost each pass about 1 to 2 ms whatever it draws. So the
+//!   image in place gains most where passes draw a small part of the texture (the simulator's 42
+//!   small passes a frame at 1206x2622: 70 ms of GPU a frame shadowed, 11.5 ms in place) and
+//!   loses where they blend most of it (10 such full-screen passes at 3440x1440: 18.6 ms
+//!   shadowed, 54 ms in place). The switch `host_rt_max_texels` keeps larger textures shadows.
+
+use crate::device::WeakDevice;
+use crate::exit_guard;
+use crate::in_place::{mark_checking, PagesClass, Verdict};
+use crate::in_place_check::{host_page, ClassPages};
+use crate::{release, Device, TextureDescriptor};
+use ash::vk;
+use metal2vulkan::device::HostPageTexturePolicy;
+use metal2vulkan::metal::{PixelFormat, TextureUsage};
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Barrier;
+use std::time::{Duration, Instant};
+
+/// The live switch's name.
+pub(crate) const SWITCH: &str = "host_rt_in_place";
+
+/// Whether the switch is on now.
+pub(crate) fn switched() -> bool {
+    crate::live::on(SWITCH, false)
+}
+
+/// The switch `host_rt_max_texels`: where set, a texture of more texels (its width, height and
+/// depth or layers multiplied) stays a shadow. Rendering into a linear image costs a pass on
+/// Intel's GPU far more than into an optimal one (the module docs), where the shadow's copies cost
+/// a texture's every texel at each pass: so small textures and small passes gain most.
+fn max_texels() -> Option<u64> {
+    crate::live::get("host_rt_max_texels").and_then(|v| v.parse().ok())
+}
+
+/// How long a texture's making waits for a verdict the first time it asks.
+const WAIT: Duration = Duration::from_secs(5);
+
+/// How many times each shape is checked in each class.
+const ROUNDS: usize = 2;
+
+/// The bytes of each class's buffer: past half a pooled block (so a buffer of the runtime's own
+/// lies in fresh pages), and room for the desktop's window.
+const BUFFER_BYTES: u64 = 40 << 20;
+
+/// The time between two of the CPU's writes beside the image: the writes of the desktop's
+/// non-texel bytes (about 100,000) then take about 50 ms, past the device's passes.
+const PACE: Duration = Duration::from_nanos(500);
+
+/// A shape the check makes a texture of.
+#[derive(Clone, Copy, Debug)]
+struct Shape {
+    format: PixelFormat,
+    texel: u64,
+    width: u64,
+    height: u64,
+    bytes_per_row: u64,
+    /// The bytes of one texel cleared to `(1, 1, 1, 1)`.
+    one: &'static [u8],
+}
+
+const UNORM8_ONE: [u8; 4] = [0xff; 4];
+const HALF_ONE: [u8; 8] = [0x00, 0x3c, 0x00, 0x3c, 0x00, 0x3c, 0x00, 0x3c];
+const FLOAT_ONE: [u8; 16] = [
+    0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x80, 0x3f, 0x00, 0x00, 0x80, 0x3f,
+];
+
+const SHAPES: [Shape; 6] = [
+    shape(PixelFormat::BGRA8Unorm, 4, 64, 16, 256, &UNORM8_ONE),
+    shape(PixelFormat::BGRA8Unorm, 4, 100, 50, 512, &UNORM8_ONE),
+    shape(PixelFormat::R8Unorm, 1, 61, 37, 256, &[0xff]),
+    shape(PixelFormat::RGBA16Float, 8, 33, 17, 512, &HALF_ONE),
+    shape(PixelFormat::RGBA32Float, 16, 20, 9, 512, &FLOAT_ONE),
+    shape(PixelFormat::BGRA8Unorm, 4, 3440, 1440, 13824, &UNORM8_ONE),
+];
+
+const fn shape(
+    format: PixelFormat,
+    texel: u64,
+    width: u64,
+    height: u64,
+    bytes_per_row: u64,
+    one: &'static [u8],
+) -> Shape {
+    Shape {
+        format,
+        texel,
+        width,
+        height,
+        bytes_per_row,
+        one,
+    }
+}
+
+/// A rectangle of texels: x, y, width, height.
+type Rect = [u64; 4];
+
+impl Shape {
+    /// The window the check fills: the texture's rows, then two pages past their last page.
+    fn window(&self, page: u64) -> u64 {
+        (self.bytes_per_row * self.height).next_multiple_of(page) + 2 * page
+    }
+
+    /// The rectangle the load-and-store pass clears inside it (to one).
+    fn cleared_inside(&self) -> Rect {
+        let (w, h) = (self.width, self.height);
+        [w / 4, h / 4, w / 2 - w / 4, h / 2 - h / 4]
+    }
+
+    /// The render area the clear-load pass clears (to zero).
+    fn clear_area(&self) -> Rect {
+        let (w, h) = (self.width, self.height);
+        [w / 2, h / 2, 3 * w / 4 - w / 2, 3 * h / 4 - h / 2]
+    }
+
+    /// The render area the `DONT_CARE`-load pass loads: its texels are not checked.
+    fn dont_care_area(&self) -> Rect {
+        let (w, h) = (self.width, self.height);
+        [0, 3 * h / 4, w / 4, h - 3 * h / 4]
+    }
+
+    /// The bytes of texels in a row.
+    fn row_bytes(&self) -> u64 {
+        self.width * self.texel
+    }
+
+    /// The bytes that are no texel's in a window of `length`: each row's bytes after its texels,
+    /// then every byte after the last row.
+    fn others(&self, length: u64) -> u64 {
+        let rows = self.bytes_per_row * self.height;
+        (self.bytes_per_row - self.row_bytes()) * self.height + (length - rows)
+    }
+
+    /// The offset of the `i`th byte that is no texel's.
+    fn other(&self, i: u64) -> u64 {
+        let pad = self.bytes_per_row - self.row_bytes();
+        let padding = pad * self.height;
+        if i < padding {
+            let (row, at) = (i / pad, i % pad);
+            row * self.bytes_per_row + self.row_bytes() + at
+        } else {
+            self.bytes_per_row * self.height + (i - padding)
+        }
+    }
+
+    /// What the texel byte at `offset` must hold: `Some(Some(byte))` a cleared value,
+    /// `Some(None)` the pattern, `None` unchecked; `Err(())` where it is no texel's.
+    fn texel_due(&self, offset: u64) -> Result<Option<Option<u8>>, ()> {
+        let (row, column) = (offset / self.bytes_per_row, offset % self.bytes_per_row);
+        if row >= self.height || column >= self.row_bytes() {
+            return Err(());
+        }
+        let (x, y) = (column / self.texel, row);
+        let inside = |[rx, ry, rw, rh]: Rect| x >= rx && x < rx + rw && y >= ry && y < ry + rh;
+        let byte = (column % self.texel) as usize;
+        Ok(if inside(self.dont_care_area()) {
+            None
+        } else if inside(self.clear_area()) {
+            Some(Some(0))
+        } else if inside(self.cleared_inside()) {
+            Some(Some(self.one[byte]))
+        } else {
+            Some(None)
+        })
+    }
+}
+
+impl Device {
+    /// Whether a texture over host pages of `class` that renders or writes, of `extent`, is
+    /// taken in place now (the module docs): the switch, the policy, the size switch, and both
+    /// checks' verdicts for the class, each waited for ([`WAIT`]) where pending.
+    pub(crate) fn host_rt_takes(&self, class: PagesClass, extent: [u32; 3]) -> bool {
+        if !switched() {
+            return false;
+        }
+        let texels = extent.iter().map(|&n| u64::from(n.max(1))).product::<u64>();
+        if max_texels().is_some_and(|max| texels > max) {
+            return false;
+        }
+        if self.compile_device().policy().host_page_textures != HostPageTexturePolicy::InPlace {
+            return false;
+        }
+        let first_move = self.in_place_verdict(class);
+        let first_move = match first_move {
+            Verdict::Pending => wait_for(|| self.shared().in_place.verdict(class)),
+            verdict => verdict,
+        };
+        if first_move != Verdict::Passed {
+            return false;
+        }
+        let checks = &self.shared().host_rt;
+        let verdict = match checks.verdict(class) {
+            Verdict::Pending => {
+                self.start_host_rt_checks();
+                wait_for(|| checks.verdict(class))
+            }
+            verdict => verdict,
+        };
+        verdict == Verdict::Passed
+    }
+
+    /// Start the check where the switch is on and the policy takes textures in place: as the
+    /// device is made.
+    pub(crate) fn start_host_rt_checks_if_switched(&self) {
+        let in_place =
+            self.compile_device().policy().host_page_textures == HostPageTexturePolicy::InPlace;
+        if switched() && in_place {
+            self.start_host_rt_checks();
+        }
+    }
+
+    /// Start the check on a thread of its own, where it has not started.
+    fn start_host_rt_checks(&self) {
+        let checks = &self.shared().host_rt;
+        if !checks.start() {
+            return;
+        }
+        let weak = self.downgrade();
+        let builder = std::thread::Builder::new().name("m2v-rt-check".to_owned());
+        if exit_guard::spawn(builder, move || run(weak)).is_err() {
+            for class in PagesClass::ALL {
+                if checks.verdict(class) == Verdict::Pending {
+                    checks.set(class, Verdict::Unchecked);
+                }
+            }
+            checks.settle(None);
+        }
+    }
+
+    /// macbox: start the render-target check where it has not started (whatever the
+    /// switch), and wait until every verdict is known or `timeout` passed: whether they are. A
+    /// runtime extension for the lanes.
+    #[doc(hidden)]
+    pub fn settle_host_rt_checks(&self, timeout: Duration) -> bool {
+        self.start_host_rt_checks();
+        self.shared().host_rt.wait(timeout)
+    }
+
+    /// macbox: the render-target check's verdicts now, one line per class, its notes, and
+    /// its time where it ended. A runtime extension for the lanes.
+    #[doc(hidden)]
+    pub fn host_rt_check_report(&self) -> Vec<String> {
+        report(self)
+    }
+}
+
+/// `verdict`'s answer once it is not pending, or after [`WAIT`].
+fn wait_for(verdict: impl Fn() -> Verdict) -> Verdict {
+    let deadline = Instant::now() + WAIT;
+    loop {
+        let now = verdict();
+        if now != Verdict::Pending || Instant::now() >= deadline {
+            return now;
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+/// The check's verdicts, notes and time, a line each.
+fn report(device: &Device) -> Vec<String> {
+    let checks = &device.shared().host_rt;
+    let mut lines: Vec<String> = PagesClass::ALL
+        .into_iter()
+        .map(|class| format!("{class:?}: {:?}", checks.verdict(class)))
+        .collect();
+    lines.extend(checks.notes());
+    if let Some(took) = checks.took() {
+        lines.push(format!("took {took:?}"));
+    }
+    lines
+}
+
+/// The check's thread: each class in turn, its verdict given as it is known.
+fn run(weak: WeakDevice) {
+    mark_checking();
+    let started = Instant::now();
+    for class in PagesClass::ALL {
+        let Some(device) = weak.upgrade() else {
+            return;
+        };
+        if device.shared().host_rt.verdict(class) != Verdict::Pending {
+            continue;
+        }
+        let Some(verdict) = check_class(&device, class) else {
+            return;
+        };
+        device.shared().host_rt.set(class, verdict);
+    }
+    let Some(device) = weak.upgrade() else {
+        return;
+    };
+    device.shared().host_rt.settle(Some(started.elapsed()));
+    let line = format!(
+        "metal2vulkan host_rt: render-target check: {}\n",
+        report(&device).join("; ")
+    );
+    let _ = std::io::Write::write_all(&mut std::io::stderr(), line.as_bytes());
+}
+
+/// What one round found.
+enum Round {
+    /// Every byte read as due.
+    Kept,
+    /// The texture took no image in place, or the passes were not made: why.
+    NotMade(String),
+    /// A byte read other than due: where, what was due, what was read, and the step.
+    Changed(u64, u8, u8, &'static str),
+}
+
+/// The verdict of `class` on `device`: every shape's rounds, until one fails. `None` where the
+/// process is exiting.
+fn check_class(device: &Device, class: PagesClass) -> Option<Verdict> {
+    let page = host_page();
+    let pages = {
+        let _busy = exit_guard::enter()?;
+        ClassPages::make(device, class, BUFFER_BYTES)
+    };
+    let Some(pages) = pages else {
+        return Some(Verdict::Unchecked);
+    };
+    let checks = &device.shared().host_rt;
+    let mut made = 0;
+    for shape in SHAPES {
+        if shape.window(page) > BUFFER_BYTES {
+            continue;
+        }
+        for round in 0..ROUNDS {
+            let outcome = {
+                let _busy = exit_guard::enter()?;
+                check_round(device, &pages, &shape, round, page)
+            };
+            match outcome {
+                Round::Kept => made += 1,
+                Round::NotMade(why) => {
+                    checks.note(format!(
+                        "{class:?}: no {:?} {}x{} image in place with rows {} bytes apart: {why}",
+                        shape.format, shape.width, shape.height, shape.bytes_per_row
+                    ));
+                    break;
+                }
+                Round::Changed(offset, due, read, step) => {
+                    checks.note(format!(
+                        "{class:?}: a {:?} image of {}x{} with rows {} bytes apart: byte \
+                         {offset} ({step}) read {read:#04x} where {due:#04x} was due, round \
+                         {round}",
+                        shape.format, shape.width, shape.height, shape.bytes_per_row
+                    ));
+                    return Some(Verdict::Failed);
+                }
+            }
+        }
+    }
+    Some(match (made, checks.forced_failure()) {
+        (0, _) => Verdict::Unchecked,
+        (_, true) => Verdict::Failed,
+        (_, false) => Verdict::Passed,
+    })
+}
+
+/// One round of `shape` over `pages` (the module docs).
+fn check_round(
+    device: &Device,
+    pages: &ClassPages,
+    shape: &Shape,
+    round: usize,
+    page: u64,
+) -> Round {
+    let window = Window {
+        start: pages.start,
+        length: shape.window(page),
+        shape: *shape,
+        salt: round as u64 + 1,
+    };
+    window.fill();
+    let mut descriptor =
+        TextureDescriptor::texture_2d(shape.format, shape.width, shape.height, false);
+    descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    let texture = match pages
+        .buffer
+        .new_texture(&descriptor, 0, shape.bytes_per_row)
+    {
+        Ok(texture) => texture,
+        Err(error) => return Round::NotMade(format!("{error:?}")),
+    };
+    let Some((image, format, usage, key)) = texture.in_place_target() else {
+        return Round::NotMade("a shadow".to_owned());
+    };
+    if !usage.contains(vk::ImageUsageFlags::COLOR_ATTACHMENT) {
+        return Round::NotMade(format!("its image's usage is {:#x}", usage.as_raw()));
+    }
+    let passes = match Passes::make(device, image, format, shape) {
+        Ok(passes) => passes,
+        Err(error) => return Round::NotMade(format!("its passes: {error:?}")),
+    };
+    let stop = AtomicBool::new(false);
+    let started = Barrier::new(2);
+    let written = AtomicU64::new(0);
+    let submitted = std::thread::scope(|scope| {
+        let builder = std::thread::Builder::new().name("m2v-rt-writes".to_owned());
+        let writer = exit_guard::spawn_scoped(scope, builder, || {
+            window.write_until(&stop, &started, &written);
+        });
+        if writer.is_err() {
+            return None;
+        }
+        started.wait();
+        // SAFETY (of the recording): the internal command buffer records outside a render pass;
+        // the image's first move goes first in it (its key named), and every object `passes`
+        // holds lives until the submission completed (the call waits for it).
+        let done = device.submit_internal_naming(
+            |named| named == key,
+            |raw, command_buffer| unsafe { passes.record(raw, command_buffer, shape) },
+        );
+        stop.store(true, Ordering::Release);
+        Some(done)
+    });
+    passes.release(device);
+    drop(texture);
+    match submitted {
+        Some(Ok(())) => {}
+        Some(Err(error)) => return Round::NotMade(format!("its submission: {error:?}")),
+        None => return Round::NotMade("no writer thread".to_owned()),
+    }
+    match window.compare(written.load(Ordering::Acquire)) {
+        None => Round::Kept,
+        Some((offset, due, read, step)) => Round::Changed(offset, due, read, step),
+    }
+}
+
+/// The view, render passes and framebuffer of one round.
+struct Passes {
+    view: vk::ImageView,
+    /// Loads `LOAD`, `CLEAR` and `DONT_CARE`, each storing.
+    passes: [vk::RenderPass; 3],
+    framebuffer: vk::Framebuffer,
+}
+
+impl Passes {
+    fn make(
+        device: &Device,
+        image: vk::Image,
+        format: vk::Format,
+        shape: &Shape,
+    ) -> Result<Passes, crate::error::Error> {
+        let raw = device.shared().vk();
+        let mut view_usage =
+            vk::ImageViewUsageCreateInfo::default().usage(vk::ImageUsageFlags::COLOR_ATTACHMENT);
+        let info = vk::ImageViewCreateInfo::default()
+            .image(image)
+            .view_type(vk::ImageViewType::TYPE_2D)
+            .format(format)
+            .subresource_range(vk::ImageSubresourceRange {
+                aspect_mask: vk::ImageAspectFlags::COLOR,
+                base_mip_level: 0,
+                level_count: 1,
+                base_array_layer: 0,
+                layer_count: 1,
+            })
+            .push_next(&mut view_usage);
+        // SAFETY: the device is live; the image is its own, of color attachment usage.
+        let view =
+            unsafe { crate::creation::image_view(raw, &info) }.map_err(crate::error::vulkan)?;
+        let mut made = Passes {
+            view,
+            passes: [vk::RenderPass::null(); 3],
+            framebuffer: vk::Framebuffer::null(),
+        };
+        let loads = [
+            vk::AttachmentLoadOp::LOAD,
+            vk::AttachmentLoadOp::CLEAR,
+            vk::AttachmentLoadOp::DONT_CARE,
+        ];
+        for (slot, load) in made.passes.iter_mut().zip(loads) {
+            let attachments = [vk::AttachmentDescription::default()
+                .format(format)
+                .samples(vk::SampleCountFlags::TYPE_1)
+                .load_op(load)
+                .store_op(vk::AttachmentStoreOp::STORE)
+                .stencil_load_op(vk::AttachmentLoadOp::DONT_CARE)
+                .stencil_store_op(vk::AttachmentStoreOp::DONT_CARE)
+                .initial_layout(vk::ImageLayout::GENERAL)
+                .final_layout(vk::ImageLayout::GENERAL)];
+            let colors = [vk::AttachmentReference {
+                attachment: 0,
+                layout: vk::ImageLayout::GENERAL,
+            }];
+            let subpasses = [vk::SubpassDescription::default()
+                .pipeline_bind_point(vk::PipelineBindPoint::GRAPHICS)
+                .color_attachments(&colors)];
+            let info = vk::RenderPassCreateInfo::default()
+                .attachments(&attachments)
+                .subpasses(&subpasses);
+            // SAFETY: the device is live and the description valid.
+            match unsafe { crate::creation::render_pass(raw, &info) } {
+                Ok(pass) => *slot = pass,
+                Err(error) => {
+                    made.release(device);
+                    return Err(error);
+                }
+            }
+        }
+        let views = [made.view];
+        let info = vk::FramebufferCreateInfo::default()
+            .render_pass(made.passes[0])
+            .attachments(&views)
+            .width(shape.width as u32)
+            .height(shape.height as u32)
+            .layers(1);
+        // SAFETY: the device is live; the view is of the pass's attachment's format, one level and
+        // layer of its image's extent.
+        match unsafe { crate::creation::framebuffer(raw, &info) } {
+            Ok(framebuffer) => made.framebuffer = framebuffer,
+            Err(error) => {
+                made.release(device);
+                return Err(error);
+            }
+        }
+        Ok(made)
+    }
+
+    /// Record the three passes (the module docs), between barriers, the last to the host.
+    ///
+    /// # Safety
+    ///
+    /// `command_buffer` is recording outside a render pass, after the image's first move; the
+    /// objects live until it completed.
+    unsafe fn record(&self, raw: &ash::Device, command_buffer: vk::CommandBuffer, shape: &Shape) {
+        let barrier = |dst_stage, dst_access| {
+            let memory = [vk::MemoryBarrier::default()
+                .src_access_mask(vk::AccessFlags::MEMORY_WRITE)
+                .dst_access_mask(dst_access)];
+            // SAFETY: the caller's; outside a render pass.
+            unsafe {
+                raw.cmd_pipeline_barrier(
+                    command_buffer,
+                    vk::PipelineStageFlags::ALL_COMMANDS,
+                    dst_stage,
+                    vk::DependencyFlags::empty(),
+                    &memory,
+                    &[],
+                    &[],
+                )
+            };
+        };
+        let all = vk::AccessFlags::MEMORY_READ | vk::AccessFlags::MEMORY_WRITE;
+        let rect = |[x, y, w, h]: Rect| vk::Rect2D {
+            offset: vk::Offset2D {
+                x: x as i32,
+                y: y as i32,
+            },
+            extent: vk::Extent2D {
+                width: w as u32,
+                height: h as u32,
+            },
+        };
+        let whole = rect([0, 0, shape.width, shape.height]);
+        let one = vk::ClearValue {
+            color: vk::ClearColorValue { float32: [1.0; 4] },
+        };
+        let zero = vk::ClearValue {
+            color: vk::ClearColorValue { float32: [0.0; 4] },
+        };
+        barrier(vk::PipelineStageFlags::ALL_COMMANDS, all);
+        // Load and store over the whole area, a rectangle cleared inside.
+        let begin = vk::RenderPassBeginInfo::default()
+            .render_pass(self.passes[0])
+            .framebuffer(self.framebuffer)
+            .render_area(whole);
+        let clears = [vk::ClearAttachment {
+            aspect_mask: vk::ImageAspectFlags::COLOR,
+            color_attachment: 0,
+            clear_value: one,
+        }];
+        let rects = [vk::ClearRect {
+            rect: rect(shape.cleared_inside()),
+            base_array_layer: 0,
+            layer_count: 1,
+        }];
+        // SAFETY: the caller's; the pass, framebuffer and rectangle are of the image's extent.
+        unsafe {
+            raw.cmd_begin_render_pass(command_buffer, &begin, vk::SubpassContents::INLINE);
+            raw.cmd_clear_attachments(command_buffer, &clears, &rects);
+            raw.cmd_end_render_pass(command_buffer);
+        }
+        barrier(vk::PipelineStageFlags::ALL_COMMANDS, all);
+        // A clear load over a second rectangle.
+        let values = [zero];
+        let begin = vk::RenderPassBeginInfo::default()
+            .render_pass(self.passes[1])
+            .framebuffer(self.framebuffer)
+            .render_area(rect(shape.clear_area()))
+            .clear_values(&values);
+        // SAFETY: as above.
+        unsafe {
+            raw.cmd_begin_render_pass(command_buffer, &begin, vk::SubpassContents::INLINE);
+            raw.cmd_end_render_pass(command_buffer);
+        }
+        barrier(vk::PipelineStageFlags::ALL_COMMANDS, all);
+        // A `DONT_CARE` load over a third.
+        let begin = vk::RenderPassBeginInfo::default()
+            .render_pass(self.passes[2])
+            .framebuffer(self.framebuffer)
+            .render_area(rect(shape.dont_care_area()));
+        // SAFETY: as above.
+        unsafe {
+            raw.cmd_begin_render_pass(command_buffer, &begin, vk::SubpassContents::INLINE);
+            raw.cmd_end_render_pass(command_buffer);
+        }
+        barrier(vk::PipelineStageFlags::HOST, vk::AccessFlags::HOST_READ);
+    }
+
+    /// Destroy what was made; nothing uses it.
+    fn release(&self, device: &Device) {
+        let raw = device.shared().vk();
+        // SAFETY: the objects are this device's, and no pending command uses them.
+        unsafe {
+            if self.framebuffer != vk::Framebuffer::null() {
+                release::object(raw, self.framebuffer);
+            }
+            for &pass in &self.passes {
+                if pass != vk::RenderPass::null() {
+                    release::object(raw, pass);
+                }
+            }
+            release::object(raw, self.view);
+        }
+    }
+}
+
+/// A round's window of a class's pages, from its byte 0, and what it holds.
+#[derive(Clone, Copy)]
+struct Window {
+    start: NonNull<u8>,
+    length: u64,
+    shape: Shape,
+    salt: u64,
+}
+
+// SAFETY: the window's pages stay mapped while the round uses them (its buffer holds them), and
+// the writer thread writes only bytes the round's thread does not touch until it joined it.
+unsafe impl Send for Window {}
+// SAFETY: as above.
+unsafe impl Sync for Window {}
+
+impl Window {
+    /// The pattern's byte at `offset`: a hash of its place and the round.
+    fn pattern(&self, offset: u64) -> u8 {
+        let mixed = (offset ^ self.salt.rotate_left(17)).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+        (mixed >> 56) as u8
+    }
+
+    fn byte(&self, offset: u64) -> *mut u8 {
+        // SAFETY: the offset lies in the window, whose pages are mapped.
+        unsafe { self.start.as_ptr().add(offset as usize) }
+    }
+
+    /// Fill the window with the pattern.
+    fn fill(&self) {
+        // SAFETY: the window's bytes, mapped and writable; nothing else touches them meanwhile.
+        let bytes = unsafe { std::slice::from_raw_parts_mut(self.byte(0), self.length as usize) };
+        for (offset, byte) in bytes.iter_mut().enumerate() {
+            *byte = self.pattern(offset as u64);
+        }
+    }
+
+    /// The stride the writer walks the bytes that are no texel's at: coprime with their count.
+    fn stride(&self) -> u64 {
+        let count = self.shape.others(self.length);
+        let coprime = |mut a: u64, mut b: u64| {
+            while b != 0 {
+                (a, b) = (b, a % b);
+            }
+            a == 1
+        };
+        (1_000_003u64..)
+            .step_by(2)
+            .find(|&stride| coprime(stride, count))
+            .unwrap_or(1)
+    }
+
+    /// The offset of the `n`th byte the writer writes.
+    fn nth(&self, n: u64, stride: u64) -> u64 {
+        let count = self.shape.others(self.length);
+        let i = (u128::from(n) * u128::from(stride) % u128::from(count)) as u64;
+        self.shape.other(i)
+    }
+
+    /// Write the pattern's complement into each byte that is no texel's once, paced, until
+    /// `stop` or every one is written; `started` once the first is.
+    fn write_until(&self, stop: &AtomicBool, started: &Barrier, written: &AtomicU64) {
+        let (count, stride) = (self.shape.others(self.length), self.stride());
+        let begun = Instant::now();
+        let mut n = 0;
+        while n < count && (n == 0 || !stop.load(Ordering::Acquire)) {
+            let offset = self.nth(n, stride);
+            // SAFETY: a byte of the window no texel holds; the round's thread does not touch it
+            // until it joined this one.
+            unsafe { self.byte(offset).write_volatile(!self.pattern(offset)) };
+            n += 1;
+            if n == 1 {
+                started.wait();
+            }
+            while begun.elapsed() < PACE * n as u32 && !stop.load(Ordering::Relaxed) {
+                std::hint::spin_loop();
+            }
+        }
+        if n == 0 {
+            started.wait();
+        }
+        written.store(n, Ordering::Release);
+    }
+
+    /// The first byte that reads other than due, where the writer wrote `written`: its offset,
+    /// what was due, what was read, and which step.
+    fn compare(&self, written: u64) -> Option<(u64, u8, u8, &'static str)> {
+        let stride = self.stride();
+        for n in 0..written {
+            let offset = self.nth(n, stride);
+            let due = !self.pattern(offset);
+            // SAFETY: the writer was joined.
+            let read = unsafe { self.byte(offset).read_volatile() };
+            if read != due {
+                return Some((offset, due, read, "the CPU's write beside the image"));
+            }
+            // SAFETY: as above.
+            unsafe { self.byte(offset).write_volatile(self.pattern(offset)) };
+        }
+        // SAFETY: as above; nothing writes the bytes while they are read.
+        let bytes = unsafe { std::slice::from_raw_parts(self.byte(0), self.length as usize) };
+        for (offset, &read) in bytes.iter().enumerate() {
+            let offset = offset as u64;
+            let (due, step) = match self.shape.texel_due(offset) {
+                Err(()) => (self.pattern(offset), "a byte beside the image"),
+                Ok(None) => continue,
+                Ok(Some(None)) => (self.pattern(offset), "a texel no pass wrote"),
+                Ok(Some(Some(value))) => (value, "a cleared texel"),
+            };
+            if read != due {
+                return Some((offset, due, read, step));
+            }
+        }
+        None
+    }
+}

+/// keeps uncompressed): the list a plan of the texture's usage without `PixelFormatView` takes, or
+/// its own format alone. A view of a texture over a buffer in another pixel format is a texture of
+/// its own over the same bytes, with an image (or shadow) of its own (`Texture::view_storage`), so
+/// no view of another format is ever made of the shadow's image; the runtime's own views of it
+/// (its sRGB twin, a storage alias, the copies' word view, added after) are those the list holds.
+/// The shadow's compression is not observable: every byte of the texture reaches the buffer
+/// through its copies. Any other plan is returned as it is.
+fn shadow_compressible(
+    mut plan: ImagePlan,
+    layout: &TextureLayout,
+    usage: TextureUsage,
+    facts: &ImageFacts<'_>,
+) -> ImagePlan {
+    let mutable = metal2vulkan::vk::ImageCreateFlags::MUTABLE_FORMAT;
+    if !plan.flags.contains(mutable) || !plan.view_formats.is_empty() {
+        return plan;
+    }
+    let own = plan_image(
+        layout,
+        usage.difference(TextureUsage::PIXEL_FORMAT_VIEW),
+        false,
+        facts,
+    );
+    plan.view_formats = match own {
+        Ok(own) if own.view_formats.first() == Some(&plan.format) => own.view_formats,
+        _ => vec![plan.format],
+    };
+    plan
+}

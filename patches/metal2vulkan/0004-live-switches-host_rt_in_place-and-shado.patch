diff --git a/crates/metal2vulkan-validation/src/runtime_lane/host_rt_frames.rs b/crates/metal2vulkan-validation/src/runtime_lane/host_rt_frames.rs
new file mode 100644
index 00000000..d1c701b0
--- /dev/null
+++ b/crates/metal2vulkan-validation/src/runtime_lane/host_rt_frames.rs
@@ -0,0 +1,485 @@
+//! macbox: what a desktop frame of render passes into a texture over host pages costs on
+//! the device the cfg selects, under each setting of the live switches `host_rt_in_place` and
+//! `shadow_compressed` (`metal2vulkan_runtime::live`): report only, in release builds.
+//!
+//! The surface is the macOS desktop's framebuffer as the VM's WindowServer renders it: a
+//! 3440x1440 `BGRA8Unorm` IOSurface plane with rows of 13824 bytes (64 past its 13760 bytes of
+//! texels) over anonymous pages, a `Managed` no-copy buffer over them and a texture of the plane of
+//! `RenderTarget | ShaderRead` usage, on a device that takes textures over host pages in place
+//! (`HostPageTexturePolicy::InPlace`, the product's). A frame is 10 render passes ([`Shape`]), each
+//! loading and storing the texture and blending three rectangles (the whole surface, then two
+//! quarters): in one command buffer (`Passes`), or each in its own (`PassesApart`), as the guest
+//! commits them. Each setting runs on a device of its own, the texture made after the switches
+//! changed, the settings interleaved in two rounds.
+//!
+//! `SimSmallApart` is the iOS Simulator's screen at 3x instead (1206x2622, rows of 4864 bytes), 42
+//! passes a frame of a small rectangle each, a command buffer each; `Private` and `LinearOwn` take
+//! the desktop's passes apart (an optimal texture of the device's own, a linear one).
+//!
+//! Printed per round, shape and setting (`HOST-RT-FRAME`): the texture's form, the medians and
+//! 90th percentiles of the frame's GPU time (each command buffer's `GPUEndTime` less
+//! `GPUStartTime`, summed) and of its commit to completion, and the shadow's work per frame.
+//! Checked: every setting leaves the same bytes in the pages, the texels and the bytes between
+//! the rows (a sentinel no pass may write), as the shadow does.
+
+use super::first_use_writes::CHECK_WAIT;
+use super::host_memory::Mapping;
+use super::no_copy_textures::{blending, floats, staged};
+use super::{validated_device_with, Messages, ScratchCache, WAIT};
+use crate::gpu::TEST_DEVICE;
+use metal2vulkan::device::HostPageTexturePolicy;
+use metal2vulkan::metal::{PixelFormat, PrimitiveType, TextureUsage};
+use metal2vulkan_runtime::{
+    live, Buffer, CommandBuffer, CpuCacheMode, Device, HazardTrackingMode, HostMemory,
+    IoSurfacePlane, LoadAction, RenderPassDescriptor, RenderPipelineState, ResourceOptions,
+    StorageMode, StoreAction, Texture, TextureDescriptor, WorkCounts,
+};
+use std::time::Instant;
+
+const WARM: usize = 10;
+const FRAMES: usize = 40;
+
+/// What a frame does.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Shape {
+    /// The desktop (3440x1440, rows of 13824 bytes): one command buffer, 10 passes into the
+    /// surface's texture, an encoder each, each blending the whole surface and two quarters.
+    Passes,
+    /// As [`Shape::Passes`], the texture also of `PixelFormatView` usage (a shadow planned
+    /// mutable to any format: the case `shadow_compressed` changes).
+    PassesViews,
+    /// The desktop: 10 command buffers of one such pass each.
+    PassesApart,
+    /// The desktop: 10 command buffers of one pass each, each blending one rectangle of a
+    /// sixteenth of the surface (its middle), with no scissor: a window's update.
+    SmallApart,
+    /// The iOS Simulator's screen at 3x (1206x2622, rows of 4864 bytes): 42 command buffers of
+    /// one pass each blending a sixteenth of it, as the coordinator measured the sim's frames.
+    SimSmallApart,
+}
+
+impl Shape {
+    /// Width, height, bytes per row, passes per frame, a command buffer per pass, small rects.
+    fn of(self) -> (u64, u64, u64, usize, bool, bool) {
+        match self {
+            Shape::Passes | Shape::PassesViews => (3440, 1440, 13824, 10, false, false),
+            Shape::PassesApart => (3440, 1440, 13824, 10, true, false),
+            Shape::SmallApart => (3440, 1440, 13824, 10, true, true),
+            Shape::SimSmallApart => (1206, 2622, 4864, 42, true, true),
+        }
+    }
+}
+
+const SHAPES: [Shape; 5] = [
+    Shape::Passes,
+    Shape::PassesViews,
+    Shape::PassesApart,
+    Shape::SmallApart,
+    Shape::SimSmallApart,
+];
+
+/// The switches' settings weighed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Setting {
+    /// Both off: today's shadow, copied in and merged back.
+    Shadow,
+    /// `host_rt_in_place`: the texture in place.
+    InPlace,
+    /// `shadow_compressed`: the shadow, its image eligible for the driver's compression.
+    Compressed,
+    /// For the parts: the passes into a `Private` texture of the surface's size (optimal tiling,
+    /// the device's own memory), no shadow.
+    Private,
+    /// For the parts: the passes into a linear image over a `Private` buffer's bytes, rows of
+    /// 13760 bytes (packed), aliased: linear tiling in the device's own memory.
+    LinearOwn,
+}
+
+impl Setting {
+    fn switches(self) -> [(&'static str, &'static str); 2] {
+        let on = |yes: bool| if yes { "1" } else { "0" };
+        [
+            ("host_rt_in_place", on(self == Setting::InPlace)),
+            ("shadow_compressed", on(self == Setting::Compressed)),
+        ]
+    }
+}
+
+const SETTINGS: [Setting; 5] = [
+    Setting::Shadow,
+    Setting::InPlace,
+    Setting::Compressed,
+    Setting::Private,
+    Setting::LinearOwn,
+];
+
+fn median_p90(mut values: Vec<f64>) -> (f64, f64) {
+    values.sort_by(f64::total_cmp);
+    let at = |p: usize| values[(values.len() * p / 100).min(values.len() - 1)];
+    (at(50), at(90))
+}
+
+fn surface_buffer(device: &Device, mapping: &Mapping, len: usize) -> Buffer {
+    let managed = ResourceOptions::new(
+        StorageMode::Managed,
+        CpuCacheMode::DefaultCache,
+        HazardTrackingMode::Default,
+    );
+    // SAFETY: the mapping outlives every buffer over it (the test drops them first).
+    let memory = unsafe { HostMemory::new(mapping.pointer()) };
+    // SAFETY: as above.
+    unsafe { device.new_buffer_with_bytes_no_copy(memory, len as u64, managed, None) }.unwrap()
+}
+
+fn plane_texture(buffer: &Buffer, shape: Shape) -> Texture {
+    let (width, height, row, ..) = shape.of();
+    let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, width, height, false);
+    d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    if shape == Shape::PassesViews {
+        d.usage |= TextureUsage::PIXEL_FORMAT_VIEW;
+    }
+    d.resource_options = buffer.resource_options();
+    buffer
+        .new_texture_with_iosurface_plane(&d, IoSurfacePlane::new(0, row, false))
+        .unwrap()
+}
+
+fn form_of(texture: &Texture) -> &'static str {
+    // SAFETY: the handle is only compared, while the texture lives.
+    match unsafe { texture.vk_image() }.is_some() {
+        true => "in place",
+        false => "shadowed",
+    }
+}
+
+fn pass(
+    command_buffer: &CommandBuffer,
+    texture: &Texture,
+    blend: &RenderPipelineState,
+    rects: &[Buffer],
+    color: &Buffer,
+) {
+    let mut descriptor = RenderPassDescriptor::new();
+    let attachment = &mut descriptor.color_attachments[0];
+    attachment.texture = Some(texture.clone());
+    attachment.load_action = LoadAction::Load;
+    attachment.store_action = StoreAction::Store;
+    let mut encoder = command_buffer.render_command_encoder(&descriptor).unwrap();
+    encoder.set_render_pipeline_state(blend).unwrap();
+    encoder.set_fragment_buffer(Some(color), 0, 0).unwrap();
+    for rect in rects {
+        encoder.set_vertex_buffer(Some(rect), 0, 0).unwrap();
+        encoder
+            .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+            .unwrap();
+    }
+    encoder.end_encoding().unwrap();
+}
+
+fn per_frame(before: &WorkCounts, after: &WorkCounts) -> String {
+    let per = |f: fn(&WorkCounts) -> u64| (f(after) - f(before)) as f64 / FRAMES as f64;
+    format!(
+        "shadow copies {:.1}, texels in {:.0}, back {:.0}, copies in dispatched {:.1}, copies \
+         back dispatched {:.1}, merge copies dispatched {:.1}, command buffers {:.1}",
+        per(|c| c.shadow_copies),
+        per(|c| c.shadow_texels_copied_in),
+        per(|c| c.shadow_texels_copied_back),
+        per(|c| c.shadow_copies_in_dispatched),
+        per(|c| c.shadow_copies_back_dispatched),
+        per(|c| c.shadow_merge_copies_dispatched),
+        per(|c| c.command_buffers_submitted),
+    )
+}
+
+/// A hash of the bytes, FNV-1a.
+fn hash(bytes: &[u8]) -> u64 {
+    bytes.iter().fold(0xcbf2_9ce4_8422_2325, |h, &b| {
+        (h ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3)
+    })
+}
+
+/// The desktop's frames under each setting (the module docs).
+#[test]
+#[ignore = "a release-mode measurement: run by name"]
+fn host_rt_frame_costs() {
+    let len = ((13824 * 1440) as usize).next_multiple_of(16384);
+    let mapping = Mapping::anonymous(len);
+    // SAFETY: the mapping's bytes, which no device uses between the cases.
+    let bytes = || unsafe { std::slice::from_raw_parts_mut(mapping.pointer().as_ptr(), len) };
+    let mut results: Vec<(Shape, Setting, u64, bool)> = Vec::new();
+    for round in 0..2 {
+        for shape in SHAPES {
+            let (width, height, row, passes, apart, small_rects) = shape.of();
+            for setting in SETTINGS {
+                // The parts are the desktop's; the sim's 4824-byte packed rows make no linear
+                // image on ANV.
+                let parts = matches!(setting, Setting::Private | Setting::LinearOwn);
+                if (shape == Shape::PassesViews && parts)
+                    || (shape == Shape::SimSmallApart && setting == Setting::LinearOwn)
+                {
+                    continue;
+                }
+                for (name, value) in setting.switches() {
+                    live::set(name, Some(value));
+                }
+                // Every byte a sentinel the passes overwrite in texels alone.
+                for (i, byte) in bytes().iter_mut().enumerate() {
+                    *byte = (i % 251) as u8;
+                }
+                let cache = ScratchCache::new().unwrap();
+                let messages = Messages::default();
+                let device = validated_device_with(TEST_DEVICE, &messages, cache.path(), |o| {
+                    o.layers.clear();
+                    o.policy.host_page_textures = HostPageTexturePolicy::InPlace;
+                })
+                .unwrap();
+                assert!(
+                    device.settle_in_place_checks(CHECK_WAIT),
+                    "the in-place check answered"
+                );
+                if round == 0 && shape == Shape::Passes && setting == Setting::Shadow {
+                    for line in device.in_place_check_report() {
+                        eprintln!("IN-PLACE-CHECK on {}: {line}", device.name());
+                    }
+                }
+                if setting == Setting::InPlace {
+                    assert!(
+                        device.settle_host_rt_checks(CHECK_WAIT),
+                        "the render-target check answered"
+                    );
+                    if round == 0 && shape == Shape::Passes {
+                        for line in device.host_rt_check_report() {
+                            eprintln!("HOST-RT-CHECK on {}: {line}", device.name());
+                        }
+                    }
+                }
+                let queue = device.new_command_queue().unwrap();
+                let blend = blending(&device, PixelFormat::BGRA8Unorm);
+                let full = [
+                    staged(&device, &floats([-1.0, -1.0, 1.0, 1.0])),
+                    staged(&device, &floats([-1.0, -1.0, 0.0, 0.0])),
+                    staged(&device, &floats([0.0, 0.0, 1.0, 1.0])),
+                ];
+                let small = [staged(&device, &floats([-0.25, -0.25, 0.25, 0.25]))];
+                let rects: &[Buffer] = match small_rects {
+                    true => &small,
+                    false => &full,
+                };
+                let color = staged(&device, &floats([0.25, 0.5, 0.75, 0.5]));
+                let (buffer, surface, form) = match setting {
+                    Setting::Private => {
+                        let mut d = TextureDescriptor::texture_2d(
+                            PixelFormat::BGRA8Unorm,
+                            width,
+                            height,
+                            false,
+                        );
+                        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+                        d.resource_options = ResourceOptions::private();
+                        let buffer = device.new_buffer(256, ResourceOptions::private()).unwrap();
+                        (buffer, device.new_texture(&d).unwrap(), "private")
+                    }
+                    Setting::LinearOwn => {
+                        let buffer = device
+                            .new_buffer(width * 4 * height, ResourceOptions::private())
+                            .unwrap();
+                        let mut d = TextureDescriptor::texture_2d(
+                            PixelFormat::BGRA8Unorm,
+                            width,
+                            height,
+                            false,
+                        );
+                        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+                        d.resource_options = buffer.resource_options();
+                        let texture = buffer.new_texture(&d, 0, width * 4).unwrap();
+                        let form = match form_of(&texture) {
+                            "in place" => "linear over a private buffer",
+                            _ => "shadowed over a private buffer",
+                        };
+                        (buffer, texture, form)
+                    }
+                    _ => {
+                        let buffer = surface_buffer(&device, &mapping, len);
+                        let surface = plane_texture(&buffer, shape);
+                        let form = form_of(&surface);
+                        (buffer, surface, form)
+                    }
+                };
+                let (mut waits, mut gpus) = (Vec::new(), Vec::new());
+                let mut before = device.work_counts();
+                for k in 0..WARM + FRAMES {
+                    if k == WARM {
+                        before = device.work_counts();
+                    }
+                    let mut command_buffers = vec![queue.command_buffer().unwrap()];
+                    pass(&command_buffers[0], &surface, &blend, rects, &color);
+                    for _ in 1..passes {
+                        if apart {
+                            let command_buffer = queue.command_buffer().unwrap();
+                            pass(&command_buffer, &surface, &blend, rects, &color);
+                            command_buffers.push(command_buffer);
+                        } else {
+                            pass(&command_buffers[0], &surface, &blend, rects, &color);
+                        }
+                    }
+                    let committed = Instant::now();
+                    for command_buffer in &command_buffers {
+                        command_buffer.commit().unwrap();
+                    }
+                    let mut gpu = 0.0;
+                    for command_buffer in &command_buffers {
+                        command_buffer.wait_until_completed_for(WAIT).unwrap();
+                        assert_eq!(command_buffer.error(), None);
+                        gpu += command_buffer.gpu_end_time().unwrap()
+                            - command_buffer.gpu_start_time().unwrap();
+                    }
+                    if k >= WARM {
+                        waits.push(committed.elapsed().as_secs_f64() * 1e3);
+                        gpus.push(gpu * 1e3);
+                    }
+                }
+                let after = device.work_counts();
+                drop((surface, buffer));
+                let (gpu, gpu90) = median_p90(gpus);
+                let (wait, wait90) = median_p90(waits);
+                // The texels, and the bytes between the rows: the sentinel.
+                let surface_bytes = &bytes()[..(row * height) as usize];
+                let digest = hash(surface_bytes);
+                let between_kept = surface_bytes
+                    .iter()
+                    .enumerate()
+                    .all(|(i, &b)| (i as u64 % row) < width * 4 || b == (i % 251) as u8);
+                println!(
+                    "HOST-RT-FRAME on {}: round {round}, {shape:?}, {setting:?}: the texture \
+                     {form}; GPU {gpu:.2} ms (p90 {gpu90:.2}), commit to completion {wait:.2} ms \
+                     (p90 {wait90:.2}); bytes {digest:016x}, between the rows kept {between_kept}; \
+                     per frame: {}",
+                    device.name(),
+                    per_frame(&before, &after),
+                );
+                results.push((shape, setting, digest, between_kept));
+            }
+        }
+    }
+    for (name, _) in Setting::Shadow.switches() {
+        live::set(name, None);
+    }
+    for &(shape, setting, digest, between_kept) in &results {
+        if matches!(setting, Setting::Private | Setting::LinearOwn) {
+            continue;
+        }
+        let shadow = results
+            .iter()
+            .find(|r| r.0 == shape && r.1 == Setting::Shadow)
+            .map(|r| r.2);
+        assert!(
+            between_kept,
+            "{shape:?} {setting:?}: a byte between the rows changed"
+        );
+        assert_eq!(
+            Some(digest),
+            shadow,
+            "{shape:?} {setting:?}: other bytes than the shadow's"
+        );
+    }
+}
+
+/// macbox probe: a pass that clears to (0.1, 0.2, 0.3, 0.4) (and blends over the left
+/// half, or draws nothing) into a texture in place over host pages, a `Private` texture and a
+/// linear image over a `Private` buffer: the bytes of texel 0 and of a texel in the right half of
+/// each (`RT-PROBE`). On ANV 26.2.4 both linear images' clears write red 0x19 where the
+/// `Private` texture's writes 0x1a; the blends over them agree.
+#[test]
+#[ignore = "a probe: run by name"]
+fn host_rt_clear_probe() {
+    use metal2vulkan_runtime::ClearColor;
+    let (w, h) = (1920u64, 1080u64);
+    let row = w * 4;
+    let len = ((row * h) as usize).next_multiple_of(16384);
+    let mapping = Mapping::anonymous(len);
+    live::set("host_rt_in_place", Some("1"));
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    let device = validated_device_with(TEST_DEVICE, &messages, cache.path(), |o| {
+        o.policy.host_page_textures = HostPageTexturePolicy::InPlace;
+    })
+    .unwrap();
+    assert!(device.settle_in_place_checks(CHECK_WAIT));
+    assert!(device.settle_host_rt_checks(CHECK_WAIT));
+    let queue = device.new_command_queue().unwrap();
+    let blend = blending(&device, PixelFormat::BGRA8Unorm);
+    let left = staged(&device, &floats([-1.0, -1.0, 0.0, 1.0]));
+    let color = staged(&device, &floats([0.2, 0.4, 0.6, 0.5]));
+    let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, w, h, false);
+    d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    let host = surface_buffer(&device, &mapping, len);
+    d.resource_options = host.resource_options();
+    let in_place = host.new_texture(&d, 0, row).unwrap();
+    d.resource_options = ResourceOptions::private();
+    let private = device.new_texture(&d).unwrap();
+    let own = device
+        .new_buffer(row * h, ResourceOptions::private())
+        .unwrap();
+    d.resource_options = own.resource_options();
+    let linear = own.new_texture(&d, 0, row).unwrap();
+    for draws in [false, true] {
+        for (name, texture) in [
+            ("in place", &in_place),
+            ("private", &private),
+            ("linear", &linear),
+        ] {
+            let out = device
+                .new_buffer(row * h, ResourceOptions::shared())
+                .unwrap();
+            let command_buffer = queue.command_buffer().unwrap();
+            let mut pass = RenderPassDescriptor::new();
+            let attachment = &mut pass.color_attachments[0];
+            attachment.texture = Some(texture.clone());
+            attachment.load_action = LoadAction::Clear;
+            attachment.store_action = StoreAction::Store;
+            attachment.clear_color = ClearColor::new(0.1, 0.2, 0.3, 0.4);
+            let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+            if draws {
+                encoder.set_render_pipeline_state(&blend).unwrap();
+                encoder.set_vertex_buffer(Some(&left), 0, 0).unwrap();
+                encoder.set_fragment_buffer(Some(&color), 0, 0).unwrap();
+                encoder
+                    .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+                    .unwrap();
+            }
+            encoder.end_encoding().unwrap();
+            let mut blit = command_buffer.blit_command_encoder().unwrap();
+            blit.copy_from_texture_to_buffer(
+                texture,
+                0,
+                0,
+                metal2vulkan_runtime::Origin::new(0, 0, 0),
+                metal2vulkan_runtime::Size::new(w, h, 1),
+                &out,
+                0,
+                row,
+                row * h,
+                metal2vulkan_runtime::BlitOption::None,
+            )
+            .unwrap();
+            blit.end_encoding().unwrap();
+            command_buffer.commit().unwrap();
+            command_buffer.wait_until_completed_for(WAIT).unwrap();
+            assert_eq!(command_buffer.error(), None);
+            // SAFETY: a shared buffer, its command buffer completed.
+            let bytes = unsafe {
+                std::slice::from_raw_parts(out.contents().unwrap().as_ptr(), (row * h) as usize)
+            };
+            let at = |x: u64, y: u64| {
+                let o = (y * row + x * 4) as usize;
+                bytes[o..o + 4].to_vec()
+            };
+            eprintln!(
+                "RT-PROBE draws {draws}, {name}: texel 0 {:02x?}, texel (1500, 500) {:02x?}",
+                at(0, 0),
+                at(1500, 500)
+            );
+        }
+    }
+    live::set("host_rt_in_place", None);
+}

+/// macbox: the plans an image in place of a texture over host pages that renders or
+/// writes is tried with (`host_rt.rs`), the first the device makes: as a linear image aliasing a
+/// buffer of the runtime's own is (`Device::storage_over_buffer`'s `None` branch): with the
+/// feedback loop usage, then with the usage the texture lacks, then with its own plan. A linear
+/// image is never compressed, and its memory is the pages', so the wider usage costs it nothing.
+fn host_rt_plans(
+    device: &Device,
+    plan: &ImagePlan,
+    layout: &TextureLayout,
+    usage: TextureUsage,
+    facts: &ImageFacts<'_>,

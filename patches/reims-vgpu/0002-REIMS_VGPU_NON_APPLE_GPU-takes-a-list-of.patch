-        supports_non_square_tile_shaders: stand_in::TILE_SHADERS && !non_apple_gpu(),
+        supports_non_square_tile_shaders: stand_in::TILE_SHADERS && !non_apple_gpu("tile"),
         supports_programmable_sample_positions: query(
             "areProgrammableSamplePositionsSupported",
             props.are_programmable_sample_positions_supported(),
@@ -382,7 +387,7 @@ fn computed(device: &rt::Device, private: &rt::PrivateProperties) -> (u64, Limit
         supports_simd_reduction: simd_reduction,
         supports_simd_shuffle_and_fill: simd_shuffle_and_fill,
         supports_texture_2d_multisample_array: stand_in::TEXTURE_2D_MULTISAMPLE_ARRAY,
-        supports_tile_shaders: stand_in::TILE_SHADERS && !non_apple_gpu(),
+        supports_tile_shaders: stand_in::TILE_SHADERS && !non_apple_gpu("tile"),
     };
     let amplification = amplification.min(count(C::MaxVertexAmplificationCount));
     (amplification, limits, flags)
@@ -472,7 +477,7 @@ pub fn read(device: &rt::Device, registry_id: u64, page_size: u64) -> Arc<Device
                     .unwrap_or(false),
             })
         }),
-        families: if non_apple_gpu() { [false; 7] } else { stand_in::FAMILIES }.map(Ok),
+        families: if non_apple_gpu("families") { [false; 7] } else { stand_in::FAMILIES }.map(Ok),
         write_rounding_modes: WRITE_ROUNDING_MODES
             .map(|mode| Ok(props.supports_texture_write_rounding_mode(mode.cast_unsigned()))),
         heap_buffer_page_private: heap_buffer_size_and_align(device, page_size, HEAP_QUERY_OPTIONS),

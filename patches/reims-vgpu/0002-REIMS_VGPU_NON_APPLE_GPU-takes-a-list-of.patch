-        supports_extended_xr10_formats: stand_in::EXTENDED_XR10_FORMATS && !non_apple_gpu(),
+        supports_extended_xr10_formats: stand_in::EXTENDED_XR10_FORMATS && !non_apple_gpu("xr10"),
         supports_float16_bcubic_filtering: stand_in::FLOAT16_BCUBIC_FILTERING,

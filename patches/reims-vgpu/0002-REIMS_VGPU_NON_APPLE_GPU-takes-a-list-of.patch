@@ -181,21 +181,26 @@ const PUBLIC_PRIMITIVE_TYPES: u64 = 5;
 /// The stand-ins: the Metal platform's answers on an Apple M3 Max, where no documented fact
 /// gives one (the module's table). The registry ID, which Metal answers at run time, is the
 /// OS's ([`crate::os::default_registry_id`]).
-/// macbox: `REIMS_VGPU_NON_APPLE_GPU=1` answers the guest as Apple's framework does on an
-/// Intel or AMD Mac's GPU: no Apple GPU family (device info key 28 bit 0 off, key 37 Apple5's
-/// fallback 1005, key 44 none), and no tile shaders, imageblocks, raster order groups,
-/// framebuffer reads or extended XR10 formats, so the guest's compositor takes the paths it
-/// takes on an immediate-mode GPU instead of a tiler's, which this platform emulates at a cost.
-/// Read at device creation; a guest sees the new answers from its next cold boot.
-pub fn non_apple_gpu() -> bool {
-    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
-    *ON.get_or_init(|| {
-        let on = std::env::var_os("REIMS_VGPU_NON_APPLE_GPU").is_some_and(|v| v == "1");
-        if on {
-            log::info!("REIMS_VGPU_NON_APPLE_GPU: answering as a GPU of no Apple family (no tile shaders, imageblocks, raster order groups, framebuffer reads, XR10)");
+/// macbox: `REIMS_VGPU_NON_APPLE_GPU` answers the guest as Apple's framework does on an
+/// Intel or AMD Mac's GPU, part by part, so the guest's compositor takes an immediate-mode GPU's
+/// paths instead of a tiler's, which this platform emulates at a cost. Its value is `1` or `all`
+/// for every part, or a comma list of: `families` (no Apple GPU family: device info key 28 bit 0
+/// off, key 37 Apple5's fallback 1005, key 44 none), `tile` (no tile shaders), `imageblocks`,
+/// `rog` (no raster order groups), `fbread` (no framebuffer reads) and `xr10` (no extended XR10
+/// formats). Read once, at device creation; a guest sees new answers from its next cold boot.
+/// `fbread` breaks WindowServer here: the guest's plugin always answers memoryless render targets
+/// yes, and without framebuffer reads WindowServer reads them across passes, which Metal fails.
+pub fn non_apple_gpu(part: &str) -> bool {
+    static PARTS: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    let parts = PARTS.get_or_init(|| {
+        let v = std::env::var("REIMS_VGPU_NON_APPLE_GPU").unwrap_or_default();
+        let parts: Vec<String> = v.split(',').map(|p| p.trim().to_owned()).filter(|p| !p.is_empty()).collect();
+        if !parts.is_empty() {
+            log::info!("REIMS_VGPU_NON_APPLE_GPU={v}: answering these parts as a GPU of no Apple family");
         }
-        on
-    })
+        parts
+    });
+    parts.iter().any(|p| p == "1" || p == "all" || p == part)
 }
 

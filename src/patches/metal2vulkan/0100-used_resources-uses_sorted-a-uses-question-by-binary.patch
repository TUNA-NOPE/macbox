+/// LOCAL (Atlas): the identities a `uses` question asks about: in any order, looked up one by one,
+/// or sorted ascending (`ObjectId`'s order, as a `BTreeSet` iterates them), looked up by binary
+/// search. A program that asks with many identities on each submission (Reims's check of the
+/// detached objects, `CommandBuffer::set_submission_check`) asks with them sorted: the answer is
+/// the same, without a scan of all of them for each resource the commands name.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Among<'a> {
+    Any(&'a [ObjectId]),
+    Sorted(&'a [ObjectId]),
+}
+
+impl Among<'_> {
+    pub(crate) fn contains(&self, id: &ObjectId) -> bool {
+        match self {
+            Among::Any(objects) => objects.contains(id),
+            Among::Sorted(objects) => objects.binary_search(id).is_ok(),
+        }
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        match self {
+            Among::Any(objects) | Among::Sorted(objects) => objects.is_empty(),
+        }
+    }
+
+    /// `objects` as asked: sorted where the caller said so; in a debug build that is checked.
+    pub(crate) fn sorted(objects: &[ObjectId]) -> Among<'_> {
+        debug_assert!(objects.is_sorted(), "identities said sorted are not");
+        Among::Sorted(objects)
+    }
+}
+
 impl CommandBuffer {
     /// Whether the commands of its ended encoders use any of `objects`, the identities
     /// ([`Buffer::object_id`], [`Texture::object_id`], [`Heap::object_id`]) of what
@@ -563,7 +595,14 @@ impl CommandBuffer {
     /// command buffer completed, and for an empty `objects`.
     pub fn uses(&self, objects: &[ObjectId]) -> bool {
         self.settle_end();
-        self.state().uses(self.device().shared(), None, objects)
+        self.state().uses(self.device().shared(), None, Among::Any(objects))
+    }
+
+    /// [`uses`](Self::uses) for `objects` sorted ascending (`ObjectId`'s order): the same answer,
+    /// each identity looked up by binary search. LOCAL (Atlas).
+    pub fn uses_sorted(&self, objects: &[ObjectId]) -> bool {
+        self.settle_end();
+        self.state().uses(self.device().shared(), None, Among::sorted(objects))
     }
 
     /// Whether the commands of its ended encoders at `encoders` (their places, the index of
@@ -572,7 +611,7 @@ impl CommandBuffer {
     /// a runtime extension, no Metal call. False for a range past its ended encoders.
     pub fn encoders_use(&self, encoders: std::ops::Range<usize>, objects: &[ObjectId]) -> bool {
         self.settle_end();
-        (self.state()).uses(self.device().shared(), Some(encoders), objects)
+        (self.state()).uses(self.device().shared(), Some(encoders), Among::Any(objects))
     }
 }
 

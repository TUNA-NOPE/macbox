+//! LOCAL (Atlas): `Among`, the identities a `uses` question asks about: looked up sorted, by
+//! binary search, each answer is a scan's.
+
+use crate::resource::ObjectId;
+use crate::used_resources::Among;
+
+/// Of 300 identities, every third asked about, in a shuffled order and sorted: for each of the
+/// 300, and for none asked, the binary search answers as the scan.
+#[test]
+fn a_sorted_question_answers_as_a_scan() {
+    let ids: Vec<ObjectId> = (0..300).map(|_| ObjectId::new()).collect();
+    let mut asked: Vec<ObjectId> = ids.iter().copied().step_by(3).collect();
+    asked.reverse();
+    asked.swap(0, 50);
+    let mut sorted = asked.clone();
+    sorted.sort();
+    for id in &ids {
+        assert_eq!(Among::Any(&asked).contains(id), Among::Sorted(&sorted).contains(id), "{id:?}");
+    }
+    assert_eq!((ids.iter()).filter(|id| Among::Sorted(&sorted).contains(id)).count(), 100);
+    assert!(Among::Sorted(&[]).is_empty() && !Among::Sorted(&sorted).is_empty());
+}
+
+/// A question said sorted that is not is caught in a debug build.
+#[test]
+#[should_panic(expected = "identities said sorted are not")]
+#[cfg(debug_assertions)]
+fn an_unsorted_question_said_sorted_is_caught() {
+    let ids: Vec<ObjectId> = (0..3).map(|_| ObjectId::new()).collect();
+    let _ = Among::sorted(&[ids[2], ids[0]]);
+}

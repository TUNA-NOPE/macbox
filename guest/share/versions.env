# Pinned versions and checksums of what `macbox-guest tools` installs in macOS.
# Each line is KEY=value; the environment overrides any of them (then also set the matching *_SHA256).
# Checked 2026-10-28 against nodejs.org's SHASUMS256.txt, go.dev/dl's JSON and GitHub's asset digest.

# Node.js: the official macOS installer (universal), from nodejs.org.
NODE_VERSION=24.22.1
NODE_PKG_SHA256=ca7618402754944626787fca386c406a041541f097da172e92348d8b1e44e48b

# Homebrew's portable Ruby for Intel Macs (CocoaPods needs a newer Ruby than macOS's 2.6).
# 3.4.5 is the newest GitHub *release* with an x86_64 macOS asset.
RUBY_VERSION=3.4.5
RUBY_URL=https://github.com/Homebrew/homebrew-portable-ruby/releases/download/3.4.5/portable-ruby-3.4.5.el_capitan.bottle.tar.gz
RUBY_SHA256=0c78b38f22fb9b42df6918db00e6f5a80d5b35164f910ffe4c89159326ae98cf
COCOAPODS_VERSION=1.17.0

# Go (to build simslim), the official macOS installer for amd64, from go.dev.
GO_VERSION=1.27.3
GO_PKG_SHA256=76a45dfded7ab668ec9d2da270a9a98f1c623d48ba83e52d9c4060b48c1d4f84

# simslim (github.com/mobai-app/simslim, MIT): turns off a simulator's background services.
# `go install` checks the module against Go's checksum database.
SIMSLIM_VERSION=v0.12.2
